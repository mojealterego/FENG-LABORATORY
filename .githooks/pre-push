#!/bin/sh
# Inspect all commits being pushed, including confidential files later deleted.
set -eu
cd "$(git rev-parse --show-toplevel)"
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in
    0000000000000000000000000000000000000000) continue ;;
  esac
  python3 -m tools.ip_guard --range "$remote_sha" "$local_sha" || exit 1
done
